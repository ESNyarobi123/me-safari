# Backend-only values. setup:local generates unique local secrets; never commit .env.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
TRUST_PROXY=127.0.0.1,::1
DATABASE_URL=postgresql://ma_dev:CHANGE_LOCAL_PASSWORD@127.0.0.1:5433/ma_safaris
TEST_DATABASE_URL=postgresql://ma_dev:CHANGE_LOCAL_PASSWORD@127.0.0.1:5433/ma_safaris_test
REDIS_URL=redis://127.0.0.1:6380
JWT_ACCESS_SECRET=GENERATE_RANDOM_LOCAL_SECRET
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
PUBLIC_API_BASE_URL=http://127.0.0.1:4000/v1
PUBLIC_WEB_URL=http://localhost:3000
APP_DEEP_LINK_SCHEME=masafaris
ALLOWED_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMPANY_TIMEZONE=Africa/Dar_es_Salaam
STORAGE_DRIVER=local
LOCAL_PRIVATE_STORAGE_PATH=./var/private-storage
PAYMENT_PROVIDER=mock
ENABLE_DEV_PAYMENT_SIMULATION=true
MOCK_WEBHOOK_SECRET=GENERATE_DIFFERENT_RANDOM_LOCAL_SECRET
# Live mobile-money collections (set PAYMENT_PROVIDER=snippe).
# SNIPPE_API_KEY=snp_...
# SNIPPE_WEBHOOK_SECRET=whsec_...
# SNIPPE_BASE_URL=https://api.snippe.sh
# SNIPPE_HTTP_TIMEOUT_MS=10000
# Approved TZS per 1 USD; frozen per payment intent. Required for USD bookings.
# SNIPPE_TZS_PER_USD=2600
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=M&A Safaris Development <noreply@ma-safaris.local>
PUSH_PROVIDER=disabled
SEED_DEMO_PASSWORD=SET_A_LOCAL_DEVELOPMENT_PASSWORD

POSTGRES_PORT=5433
REDIS_PORT=6380
