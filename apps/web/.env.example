# Public, browser-reachable API base; no credentials or private keys.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4000/v1

# Canonical marketing origin used by sitemap.xml, robots.txt, canonical tags and
# Open Graph URLs. Set this to the public site domain for production builds.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100

# Optional, development only. When both are set the admin sign-in screen offers a
# one-click "use demo credentials" shortcut. Never set these outside local dev.
# NEXT_PUBLIC_DEMO_ADMIN_EMAIL=admin.demo@ma-safaris.local
# NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=
