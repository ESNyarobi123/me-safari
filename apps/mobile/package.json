{
  "name": "@ma-safaris/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --go",
    "ios": "expo start --go --ios",
    "iphone": "expo start --go --ios",
    "android": "adb reverse tcp:4000 tcp:4000 2>/dev/null || true; expo start --go --android",
    "run:ios": "expo run:ios",
    "run:android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "build": "expo export --platform all",
    "check": "expo install --check"
  },
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@expo-google-fonts/dm-sans": "0.4.2",
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo-google-fonts/playfair-display": "0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "5.9.1",
    "@ma-safaris/sdk": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.12",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "57.0.5",
    "test-renderer": "1.3.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.[jt]s?(x)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ]
  }
}
