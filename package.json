{
  "name": "ma-safaris", "version": "0.1.0", "private": true,
  "packageManager": "pnpm@12.11.2", "engines": {"node": ">=24.21.0 <25"},
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "infra:up": "docker compose up -d --wait && node scripts/init-infra.mjs",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @ma/database generate",
    "db:migrate": "pnpm --filter @ma/database migrate",
    "db:seed": "pnpm --filter @ma/database seed",
    "contracts:generate": "pnpm --filter @ma/api contracts && openapi-typescript docs/api.openapi.json -o packages/sdk/src/generated.ts",
    "dev:api": "pnpm --filter @ma/api dev",
    "dev:worker": "pnpm --filter @ma/worker dev",
    "dev:web": "pnpm --filter @ma/web dev",
    "dev:mobile": "npx expo start apps/mobile --go",
    "android": "adb reverse tcp:4000 tcp:4000 2>/dev/null || true; npx expo start apps/mobile --go --android",
    "ios": "npx expo start apps/mobile --go --ios",
    "iphone": "npx expo start apps/mobile --go --ios",
    "lint": "pnpm typecheck",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand tests/unit",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand tests/integration",
    "test:e2e:api": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs --runInBand tests/e2e",
    "build:api": "pnpm --filter @ma/database build && pnpm --filter @ma/backend build && pnpm --filter @ma/api build",
    "build:worker": "pnpm --filter @ma/worker build",
    "build:web": "pnpm --filter @ma/web build",
    "verify:local": "tsx scripts/verify-local.ts",
    "preflight:production": "tsx scripts/production-preflight.ts",
    "verify:snippe": "tsx scripts/verify-snippe.ts",
    "start:api:prod": "pnpm --filter @ma/api start:prod",
    "start:worker:prod": "pnpm --filter @ma/worker start:prod",
    "backup:local": "node scripts/backup-local.mjs",
    "backup:production": "node scripts/backup-production.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "restore:local": "node scripts/restore-local.mjs"
  },
  "devDependencies": {"@types/node": "24.10.0", "typescript": "5.9.3", "tsx": "4.23.15", "openapi-typescript": "7.13.0", "jest": "30.2.0", "ts-jest": "29.4.5", "@types/jest": "30.0.0", "dotenv": "17.2.3"}
}
